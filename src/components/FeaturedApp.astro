---
import { getPartner, PARTNER_REL } from '../lib/partners';
import { withBase } from '../lib/url';
import Icon from './Icon.astro';
interface Props { variant?: 'card' | 'band' }
const { variant = 'card' } = Astro.props;
const app = getPartner('voyaij');
const shot = withBase('partners/voyaij-app-cities.svg');
const shotSm = withBase('partners/voyaij-app-cities-sm.svg');
---
{variant === 'card' ? (
  <div class="fa-card">
    <span class="fa-badge"><Icon name="plane" size={14} /> Featured app</span>
    <div class="fa-body">
      <span class="fa-thumb" aria-hidden="true"><img src={shotSm} alt="" width="390" height="665" /></span>
      <div class="fa-text">
        <h3>{app.name}</h3>
        <p>{app.blurb}</p>
      </div>
    </div>
    <div class="fa-actions">
      <a class="gp-btn" href={app.playUrl} rel={PARTNER_REL} target="_blank"><svg width="18" height="20" viewBox="0 0 18 20" aria-hidden="true"><path d="M1 1l9 9-9 9z" fill="#34a853"/><path d="M1 1l11 6-2 3z" fill="#4285f4"/><path d="M1 19l11-6-2-3z" fill="#ea4335"/><path d="M12 7l5 3-5 3-2-3z" fill="#fbbc04"/></svg><span><small>Get it on</small><b>Google Play</b></span></a>
      <a class="fa-start" href={app.url} rel={PARTNER_REL} target="_blank">Get started free <Icon name="arrow" size={16} /></a>
    </div>
  </div>
) : (
  <section class="fa-band" aria-label="Featured app">
    <svg class="fa-path" viewBox="0 0 1200 200" preserveAspectRatio="none" aria-hidden="true"><path d="M-10 170 C 250 170, 330 30, 620 60 S 1000 140, 1210 20" fill="none" stroke="#fff" stroke-opacity=".35" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="2 10"/></svg>
    <div class="wrap fa-band-in">
      <div class="fa-phone" role="img" aria-label="Screenshot of the Voyaij app showing a trip with London, Paris and Amsterdam"><span class="fa-notch"></span><img src={shot} alt="" width="780" height="1330" /><span class="fa-plane"><Icon name="plane" size={18} /></span></div>
      <div class="fa-copy">
        <span class="fa-badge"><Icon name="plane" size={14} /> Featured app</span>
        <h2>{app.name}</h2>
        <p>{app.blurb}</p>
        <div class="fa-actions">
          <a class="gp-btn" href={app.playUrl} rel={PARTNER_REL} target="_blank"><svg width="18" height="20" viewBox="0 0 18 20" aria-hidden="true"><path d="M1 1l9 9-9 9z" fill="#34a853"/><path d="M1 1l11 6-2 3z" fill="#4285f4"/><path d="M1 19l11-6-2-3z" fill="#ea4335"/><path d="M12 7l5 3-5 3-2-3z" fill="#fbbc04"/></svg><span><small>Get it on</small><b>Google Play</b></span></a>
          <a class="fa-start" href={app.url} rel={PARTNER_REL} target="_blank">Get started free <Icon name="arrow" size={16} /></a>
          <a class="fa-demo" href={app.demoUrl} rel={PARTNER_REL} target="_blank">See a live demo</a>
        </div>
        <p class="fa-partner"><a href={withBase('affiliate-disclosure/')}>Partner</a></p>
      </div>
    </div>
  </section>
)}

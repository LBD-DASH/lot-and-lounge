---
import { getPartner, PARTNER_REL } from '../lib/partners';
import { withBase } from '../lib/url';
import Icon from './Icon.astro';
import FeaturedApp from './FeaturedApp.astro';
interface Props { keys: string[]; airport: string }
const { keys, airport } = Astro.props;
const list = keys.map(getPartner).filter((p) => p.kind !== 'app');
const anyAffiliate = list.some((p) => p.affiliate);
const clickName = (key: string) => `partner-${key}-${airport.toLowerCase().replace(/ /g, '-')}`;
---
{(
  <aside class="partners" aria-label="Partners">
    <FeaturedApp />
    {list.length > 0 && <>
    <h2 id="partners-h">Compare and book beyond the official lots</h2>
    <p class="muted small">
      These third-party sites can show off-airport lots and lounge passes for {airport}. Check what's included (taxes, fees,
      shuttle frequency) before you book.
      {anyAffiliate
        ? <> Some of these are affiliate links. <a href={withBase('affiliate-disclosure/')}>How we make money</a>.</>
        : <> We have no direct affiliate deal with these sites yet, though our partner networks may convert some links into affiliate links. <a href={withBase('affiliate-disclosure/')}>Disclosure</a>.</>}
    </p>
    <ul class="partner-list">
      {list.map((p) => (
        <li class={`partner k-${p.kind}`}>
          <span class="p-ico" aria-hidden="true"><Icon name={p.kind === 'lounge' ? 'lounge' : p.key === 'parksleepfly' ? 'bed' : 'car'} size={20} /></span>
          <span>
            <span class="p-kind">{p.kind === 'lounge' ? 'Lounge access' : 'Parking'}</span><br />
            <a href={p.url} rel={PARTNER_REL} target="_blank" data-goatcounter-click={clickName(p.key)} data-goatcounter-title={clickName(p.key)}>{p.name}</a>
            <span class="p-blurb">{p.blurb}</span>
          </span>
          <span class="p-go" aria-hidden="true"><Icon name="link" size={18} /></span>
        </li>
      ))}
    </ul>
    </>}
  </aside>
)}

---
interface Props { title: string; eyebrow?: string }
const { title, eyebrow = 'Lot & Lounge' } = Astro.props;
---
<header class="page-head">
  <svg class="ph-art" viewBox="0 0 480 200" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
    <g stroke="#fff" stroke-opacity=".25" stroke-width="2">{[0, 1, 2, 3, 4, 5].map((i) => <path d={`M${200 + i * 52} 200v-56`} />)}<path d="M200 144H480" /></g>
    <path d="M240 180 C 270 100, 350 60, 456 44" fill="none" stroke="#fff" stroke-opacity=".7" stroke-width="2" stroke-dasharray="2 8" stroke-linecap="round"/>
    <path transform="translate(440 24) scale(1.3) rotate(-10 12 12)" d="M21 12c0-.8-.7-1.5-1.5-1.5H15L10 3H8l2.5 7.5H6L4.5 8.5H3l1 3.5-1 3.5h1.5L6 13.5h4.5L8 21h2l5-7.5h4.5c.8 0 1.5-.7 1.5-1.5z" fill="#fff"/>
  </svg>
  <div class="wrap">
    <span class="eyebrow" style="color:#f5a524">{eyebrow}</span>
    <h1>{title}</h1>
  </div>
</header>
<div class="bay-strip" aria-hidden="true"></div>

---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { withBase, absUrl, SITE_NAME } from '../lib/url';

interface Props {
  title: string;
  description: string;
  path: string; // site-relative, e.g. "airports/atl/"
  jsonLd?: object[];
  ogType?: string;
}
const { title, description, path, jsonLd = [], ogType = 'website' } = Astro.props;
const canonical = absUrl(path, Astro.site);
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta name="p:domain_verify" content="253d78839c49f71e13d8d02ed95571ee"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1a2e" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="sitemap" href={withBase('sitemap.xml')} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <script is:inline nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1" data-cmp-ab="2">
      (function () {
          var script = document.createElement("script");
          script.async = 1;
          script.setAttribute("data-cmp-ab","2");
          script.src = 'https://tpembars.com/NjA0OTU3.js?t=604957';
          document.head.appendChild(script);
      })();
    </script>
    <script is:inline>
    (function (s, t, a, y, twenty, two) {
    s.Stay22 = s.Stay22 || {};
    s.Stay22.params = { lmaID: '6b02941047bad80e99ad379b' };
    twenty = t.createElement(a);
    two = t.getElementsByTagName(a)[0];
    twenty.async = 1;
    twenty.src = y;
    two.parentNode.insertBefore(twenty, two);
    })(window, document, 'script', 'https://lma.stay22.com/letmeallez.js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={withBase('')} aria-label="Lot & Lounge home"><Logo /><span>Lot <span class="amp">&</span> Lounge</span></a>
        <nav class="site-nav" aria-label="Main">
          <a href={withBase('')}>Airports</a>
          <a class="hide-sm" href={withBase('affiliate-disclosure/')}>Disclosure</a>
          <a href={withBase('about/')}>About</a>
          <a class="nav-cta hide-sm" href={withBase('#airports')}>Find your airport</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="bay-strip" aria-hidden="true"></div>
      <div class="wrap">
        <div>
          <a class="brand" href={withBase('')}><Logo size={30} /><span>Lot <span class="amp">&</span> Lounge</span></a>
          <p>
            Lot & Lounge compares official airport parking rates and lounge options, terminal by terminal. Prices come from
            official sources on the date shown on each page and can change without notice, so always check before you travel.
          </p>
        </div>
        <ul class="foot-links">
          <li><Icon name="shield" size={16} /><a href={withBase('affiliate-disclosure/')}>Affiliate disclosure</a></li>
          <li><Icon name="check" size={16} /><a href={withBase('privacy/')}>Privacy</a></li>
          <li><Icon name="layers" size={16} /><a href={withBase('about/')}>About & sourcing</a></li>
          <li><Icon name="pin" size={16} /><a href={withBase('sitemap.xml')}>Sitemap</a></li>
        </ul>
        <p class="foot-base">© {new Date().getFullYear()} Lot & Lounge. Not affiliated with any airport or airline.</p>
      </div>
    </footer>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/url';
---
<Base title="Page not found" description="This page doesn't exist. Browse airport parking costs and lounge options from the Lot & Lounge home page instead." path="404.html">
  <div class="wrap notfound">
    <p class="big">4<span class="p-sign" style="font-size:.8em;vertical-align:.15em">P</span>4</p>
    <h1>Page not found</h1>
    <p><a class="btn btn-amber" href={withBase('')}>See all airports <Icon name="arrow" size={18} /></a></p>
  </div>
</Base>

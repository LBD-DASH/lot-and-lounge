---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Privacy policy" description="Lot & Lounge privacy policy: a static site with no accounts, no forms and no tracking cookies set by us. What third-party links and hosting may log." path="privacy/">
  <PageHead title="Privacy policy" eyebrow="Legal" />
  <div class="wrap"><div class="prose read page-body">
    <p><strong>Last updated:</strong> 19 Nov 2026</p>
    <ul>
      <li>This is a static website. We don't run accounts, forms or comments, and we don't set tracking or advertising cookies.</li>
      <li>The site is hosted on GitHub Pages. GitHub may log technical data such as IP addresses for security and operations; see GitHub's privacy statement.</li>
      <li>When you click a link to another site (an airport, lounge operator or booking site), that site's own privacy policy applies.</li>
      <li>If we add analytics or affiliate tracking in future, we'll update this page first and describe what's collected.</li>
    </ul>
  </div></div>
</Base>
